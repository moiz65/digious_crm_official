# Environment variables for the frontend (create-react-app)
# Do NOT commit secrets to version control. Use .env.local for local secrets.

HOST=0.0.0.0
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Backend API
REACT_APP_API_URL=http://100.126.74.55:5000
REACT_APP_API_VERSION=v1

# App metadata
REACT_APP_ENV=development
REACT_APP_NAME=Digious CRM
REACT_APP_VERSION=1.0.0

# Session and inactivity behavior (values are in minutes)
REACT_APP_SESSION_TIMEOUT=30
REACT_APP_INACTIVITY_WARNING=5

# Feature flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_DEBUG=true

REACT_APP_SOCKET_URL=http://100.126.74.55:5000