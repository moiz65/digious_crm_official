# Example .env for Backend (safe to commit)
# Replace placeholders with appropriate values for your environment.

NODE_ENV=production
PORT=5000
API_VERSION=v1
CORS_ORIGINS=https://app.yourdomain.com

DB_HOST=localhost
DB_PORT=3306
DB_USER=digious_user
DB_PASSWORD=supersecretpassword
DB_NAME=Digious_CRM_DataBase

JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRY=24h

SQL_LOG=false

# SMTP Configuration (for Forgot Password emails)
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Digious CRM
